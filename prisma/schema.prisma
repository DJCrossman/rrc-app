generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Athlete ───────────────────────────────────────────────────────────────────

enum Role {
  admin
  member
}

enum Gender {
  male
  female
  nonbinary
}

model athlete {
  id              String           @id @default(dbgenerated("generate_id('ath_'::text)"))
  userId          String?          @unique
  firstName       String
  lastName        String
  nickname        String?
  phone           String
  email           String?          @unique
  role            Role             @default(member)
  gender          Gender
  dateOfBirth     DateTime         @db.Date
  dateJoined      DateTime?
  heightInCm      Float?
  weightInKg      Float?
  concept2UserId         Int?
  concept2AccessToken    String?
  concept2RefreshToken   String?
  concept2TokenExpiresAt DateTime?
  concept2ConnectedAt    DateTime?
  rcaUsername            String?
  rcaPassword            String?
  rcaConnectedAt         DateTime?
  stravaAthleteId        String?
  stravaAccessToken      String?
  stravaRefreshToken     String?
  stravaTokenExpiresAt   DateTime?
  stravaAthleteJson      Json?
  stravaConnectedAt      DateTime?
  memberships     membership[]
  createdEvents   event[]          @relation("eventCreatedBy")
  eventRsvps      event_rsvp[]
  activities      activity[]
  inboxBatches    activity_inbox[]
  pushSubscriptions       push_subscription[]
  notificationPreferences notification_preference[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ── Program / Membership ──────────────────────────────────────────────────────

model program {
  id               String       @id @default(dbgenerated("generate_id('prog_'::text)"))
  rcaProgramId     String       @unique
  rcaOrgId         Int?
  organizationName String?
  name             String
  description      String?
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  syncedAt     DateTime?
  memberships  membership[]
  groupRules   group_program[]
}

model membership {
  id        String  @id @default(dbgenerated("generate_id('mem_'::text)"))
  athleteId String
  programId String
  athlete   athlete @relation(fields: [athleteId], references: [id])
  program   program @relation(fields: [programId], references: [id])

  @@unique([athleteId, programId])
}

// ── Boat ──────────────────────────────────────────────────────────────────────

enum WeightUnit {
  kilogram
  pound
}

model boat {
  id                  String     @id @default(dbgenerated("generate_id('boat_'::text)"))
  name                String
  manufacturer        String
  seats               String
  rigging             String
  weightMinKg         Float
  weightMaxKg         Float
  preferredWeightUnit WeightUnit
  activities          activity[]
}

// ── Erg ───────────────────────────────────────────────────────────────────────

model erg {
  id              String     @id @default(dbgenerated("generate_id('erg_'::text)"))
  name            String
  manufacturer    String
  firmwareVersion String?
  hardwareVersion String?
  serialNumber    String?
  dataCode        String?
  activities      activity[]
}

// ── Workout ───────────────────────────────────────────────────────────────────

enum WorkoutType {
  distance
  time
  other
}

enum IntensityCategory {
  C1
  C2
  C3
  C4
  C5
  C6
}

model workout {
  id                String             @id @default(dbgenerated("generate_id('work_'::text)"))
  description       String
  startDate         DateTime
  workoutType       WorkoutType
  activityType      ActivityType       @default(erg)
  elapsedTime       Int?
  distance          Int?
  intervalCount     Int                @default(1)
  intensityCategory IntensityCategory
  fragments         workout_fragment[]
  activities        activity[]
  event             event?
}

model workout_fragment {
  id            String  @id @default(dbgenerated("generate_id('work_frag_'::text)"))
  workoutId     String
  rate          Int?
  elapsedTime   Int?
  distance      Int?
  relativeTo    String
  relativeSplit Float
  workout       workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

// ── Activity ──────────────────────────────────────────────────────────────────

enum ActivityType {
  water
  erg
}

model activity {
  id             String       @id @default(dbgenerated("generate_id('act_'::text)"))
  name           String
  startDate      DateTime
  timezone       String
  workoutType    WorkoutType
  elapsedTime    Int
  distance       Int
  type           ActivityType
  athleteId      String
  boatId         String?
  ergId          String?
  workoutId      String?
  stravaId       BigInt?
  stravaData     Json?
  conceptTwoId   BigInt?
  conceptTwoData Json?
  athlete        athlete      @relation(fields: [athleteId], references: [id])
  boat           boat?        @relation(fields: [boatId], references: [id])
  erg            erg?         @relation(fields: [ergId], references: [id])
  workout        workout?     @relation(fields: [workoutId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([athleteId, stravaId])
  @@unique([athleteId, conceptTwoId])
}

// ── Activity Inbox ────────────────────────────────────────────────────────────

enum IntegrationSource {
  strava
  concept2
}

enum ActivityInboxKind {
  sync
  webhook
}

enum ActivityInboxStatus {
  pending
  running
  completed
  failed
}

model activity_inbox {
  id                String              @id @default(dbgenerated("generate_id('inbox_'::text)"))
  athleteId         String
  source            IntegrationSource
  kind              ActivityInboxKind
  status            ActivityInboxStatus @default(pending)
  payload           Json
  receivedAt        DateTime            @default(now())
  completedAt       DateTime?
  errorMessage      String?
  activitiesCreated Int                 @default(0)
  attempts          Int                 @default(0)
  athlete           athlete             @relation(fields: [athleteId], references: [id])

  @@index([athleteId, status])
  @@index([status, receivedAt])
}

// ── Event ─────────────────────────────────────────────────────────────────────

enum EventType {
  training
  regatta
  volunteer
}

enum EventAudience {
  club
  groups
}

enum RsvpStatus {
  yes
  maybe
  no
}

model event {
  id             String        @id @default(dbgenerated("generate_id('evt_'::text)"))
  type           EventType
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean       @default(false)
  timezone       String        @default("America/Regina")
  location       String?
  workoutId      String?       @unique
  audience       EventAudience @default(club)
  volunteerSpots Int?
  createdById    String?
  workout        workout?      @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  createdBy      athlete?      @relation("eventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  groups         event_group[]
  rsvps          event_rsvp[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([startAt])
}

model event_group {
  id      String @id @default(dbgenerated("generate_id('evtgrp_'::text)"))
  eventId String
  groupId String
  event   event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId])
}

model event_rsvp {
  id        String     @id @default(dbgenerated("generate_id('rsvp_'::text)"))
  eventId   String
  athleteId String
  status    RsvpStatus
  event     event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete   athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt

  @@unique([eventId, athleteId])
}

model calendar_token {
  id        String   @id @default(dbgenerated("generate_id('caltok_'::text)"))
  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
}

// ── Notification ──────────────────────────────────────────────────────────────

model push_subscription {
  id         String    @id @default(dbgenerated("generate_id('sub_'::text)"))
  athleteId  String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  failedAt   DateTime?
  athlete    athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
}

model notification_preference {
  id        String   @id @default(dbgenerated("generate_id('npref_'::text)"))
  athleteId String
  scope     String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  athlete   athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, scope])
}

// ── Group ─────────────────────────────────────────────────────────────────────

model group {
  id        String          @id @default(dbgenerated("generate_id('grp_'::text)"))
  name      String
  programs  group_program[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model group_program {
  id        String  @id @default(dbgenerated("generate_id('grp_prog_'::text)"))
  groupId   String
  programId String
  group     group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  program   program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([groupId, programId])
}
